---
import MdxPageLayout from "astro-theme-university/layouts/MdxPageLayout.astro";
import { siteConfig } from "../site-config";
---

<MdxPageLayout siteConfig={siteConfig} {...Astro.props}>
  <slot />
</MdxPageLayout>

<style is:global>
  /* Field-note callouts: a blockquote reads like an annotation clipped to
     an artifact record, not a pull-quote. */
  blockquote {
    margin: 1.5rem 0;
    padding: 0.75rem 1.25rem;
    border: none;
    border-left: 3px dashed var(--at-tertiary, #6b6154);
    background: color-mix(in srgb, var(--at-tertiary, #6b6154) 6%, transparent);
    font-family: var(--at-font-mono, monospace);
    font-size: 0.95em;
  }

  blockquote::before {
    content: "FIELD NOTE";
    display: block;
    font-family: var(--at-font-mono, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: var(--at-secondary, #8a5c13);
    margin-bottom: 0.4rem;
  }

  /* Catalogue tables: ruled like a specimen ledger rather than a plain grid. */
  table {
    border-collapse: collapse;
    width: 100%;
    margin: 1.5rem 0;
    font-size: 0.95em;
  }

  table th {
    text-align: left;
    font-family: var(--at-font-mono, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--at-secondary, #8a5c13);
    border-bottom: 2px solid var(--at-primary, #b97d1c);
    padding: 0.5rem 0.75rem;
  }

  table td {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px dashed color-mix(in srgb, var(--at-tertiary, #6b6154) 40%, transparent);
  }

  table tr:last-child td {
    border-bottom: 1px solid var(--at-tertiary, #6b6154);
  }

  /* Headings get a small tick mark, echoing the excavation-grid artwork. */
  main :is(h2, h3)::before {
    content: "‣";
    color: var(--at-primary, #b97d1c);
    margin-right: 0.4rem;
  }
</style>
