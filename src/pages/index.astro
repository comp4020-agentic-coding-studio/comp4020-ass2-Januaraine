---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import heroImage from "../assets/images/hero-home.png";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  heroImage={heroImage}
  heroImageAlt="A game cartridge rendered as flat gold and black shapes, half-unearthed on a dashed survey grid with a rotated evidence tag reading artifact number 04, status partial, in a two-ink risograph print"
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <h2>What you will do</h2>
  <p>
    Excavate a real, obsolete game. You'll spend the semester learning
    emulation, archival research, and basic file-format investigation on
    worked examples — then apply all three to one lost or abandoned game you
    choose yourself. You walk out with a recovery attempt, a written
    archaeological report, and a public exhibition of what you found. A
    well-documented failure counts, provided you can prove why recovery
    wasn't possible.
  </p>

  <h2>Who it is for</h2>
  <p>
    Students with basic programming and computing literacy who want to work
    with something concrete rather than survey digital preservation from a
    distance. No advanced reverse-engineering, exploit development, or
    console-modding hardware is required — emulators and public archives are
    enough. If you're hoping to learn ROM hacking or speedrunning tech
    specifically, this isn't that course.
  </p>

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>The weekly practicum — hands-on recovery work, week by week.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>The Field Report and the Recovery Exhibit: what's marked, and when.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who runs the course and how to reach them.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }
</style>
